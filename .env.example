# Copier ce fichier en .env pour personnaliser la configuration :
#   cp .env.example .env
# Sans .env, docker-compose.yml utilise ces mêmes valeurs par défaut.
# Ce sont des mots de passe de DÉVELOPPEMENT uniquement : à changer en production.

# --- PostgreSQL
POSTGRES_DB=billetterie
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_only
POSTGRES_PORT=5432
# Rôle utilisé par l'API (droits limités, pas superutilisateur)
APP_DB_USER=billetterie_app
APP_DB_PASSWORD=app_dev_only

# --- MongoDB
MONGO_DB=billetterie
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev_only
MONGO_PORT=27017
APP_MONGO_USER=billetterie_app
APP_MONGO_PASSWORD=app_dev_only

# --- Redis
REDIS_PASSWORD=redis_dev_only
REDIS_PORT=6379

# --- API
API_PORT=3000
# Secret de signature des jetons JWT : générer une longue valeur aléatoire en production
JWT_SECRET=dev_only_change_me

# --- Outils d'administration
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin_dev_only
PGADMIN_PORT=5050
MONGO_EXPRESS_PORT=8081
